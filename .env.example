# Pooled Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL=

# Vercel Blob store token. Without it, photos fall back to public/uploads in
# development only; production refuses to start a card upload without it.
BLOB_READ_WRITE_TOKEN=

# Seeds the first owner account the first time the app runs. Once an owner
# exists these are ignored, so you can remove them afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
